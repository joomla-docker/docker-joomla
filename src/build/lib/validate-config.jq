# Validate and normalize the helper or the resolved version file.
# jq --arg mode helper|resolved -f src/build/lib/validate-config.jq FILE

def require($condition; $message):
  if $condition then . else error($message) end;
def version_number: type == "string" and test("^[0-9]+\\.[0-9]+\\.[0-9]+$");
def sha512: type == "string" and test("^[a-fA-F0-9]{128}$");
def sha256: type == "string" and test("^[a-fA-F0-9]{64}$");
def package_type: IN("tar.zst", "tar.gz", "tar.bz2");

def safe_name: type == "string" and test("^[A-Za-z0-9_+./-]+\\z");
def module_name: type == "string" and test("^[A-Za-z0-9_][A-Za-z0-9_ -]*\\z");
def command_arguments: type == "array" and length > 0 and all(.[]; type == "string" and (test("[\\r\\n]") | not)) and (.[0] | length > 0);
def absolute_path: type == "string" and test("^/[A-Za-z0-9_./-]+$") and (split("/") | index("..") == null);
def https: type == "string" and test("^https://[^[:space:]]+$");
def image_config:
  require(type == "object"; "image configuration must be an object")
  | require(has("development") | not; "use per-PHP dev settings")
  | reduce ["apt", "apk"][] as $manager (.;
      if .[$manager] != null then require(.[$manager] | type == "array" and all(.[]; safe_name); "invalid system package list") else . end
      | if .build[$manager] != null then require(.build[$manager] | type == "array" and all(.[]; safe_name); "invalid build package list") else . end)
  | require(has("sources") | not; "installer packages do not need sources; use pinned package maps")
  | reduce ["pie", "pecl", "npm"][] as $installer (.;
      if .[$installer] != null then
        require(.[$installer] | type == "object"; "installer group must be an object")
        | .[$installer] as $packages
        | reduce ($packages | keys[]) as $name (.;
            require($name | safe_name; "invalid extension package name")
            | require($packages[$name] | version_number; "invalid package version"))
      else . end)
  | require(([.pie // {} | keys[]] + [.pecl // {} | keys[]] | length) == ([.pie // {} | keys[]] + [.pecl // {} | keys[]] | unique | length); "duplicate installer ownership")
  | if .download != null then .download |= with_entries(
      require(.key | test("^[a-z][a-z0-9_]*\\z") and . != "joomla"; "invalid or reserved download name")
      | .value |= (
          require(.version | version_number; "invalid download version")
          | require(.package | https; "download requires an explicit HTTPS URL")
          | require(.destination | absolute_path; "invalid download destination")
          | require(.type | IN("binary", "tar.gz"); "unsupported download installation type")
          | if .checksum != null then require(.checksum | https; "invalid published checksum URL") else . end
          | if $mode == "resolved" then require(.sha256 | sha256; "missing download checksum") else . end)) else . end
  | if .config != null then require(.config | type == "object" and all(to_entries[]; (.key | absolute_path) and (.value | type == "array" and all(.[]; type == "string" and (contains("\n") | not)))); "invalid configuration file") else . end
  | if .environment != null then require(.environment | type == "object" and all(to_entries[]; (.key | test("^[A-Z_][A-Z0-9_]*$")) and (.value | type == "string")); "invalid environment defaults") else . end
  | if .checks != null then require(.checks | type == "array" and all(.[]; command_arguments); "invalid image check commands") else . end
  | if .extensions != null then
      reduce ["install", "enable"][] as $kind (.; if .extensions[$kind] != null then require(.extensions[$kind] | type == "array" and all(.[]; safe_name); "invalid bundled extension list") else . end)
      | if .extensions.check != null then require(.extensions.check | type == "array" and all(.[]; module_name); "invalid extension checks") else . end
    else . end;

require(type == "object" and length > 0; "configuration must contain at least one Joomla series")
| if $mode == "helper" then
    require(all(.. | objects; (has("sha256") or has("sha512")) | not);
      "checksums belong in conf/versions.json and are generated by src/build/versions.sh")
  else . end
| with_entries(
    .key as $series
    | require($series | test("^[0-9]+\\.[0-9]+$"); "invalid Joomla series: \($series)")
    | .value |= (
        require(type == "object"; "\($series): configuration must be an object")
        | require((has("php") or has("variant") or has("packageType")) | not; "\($series): php, variant and packageType belong in each release state")
        | require(.archives | type == "object" and length > 0; "\($series): missing archive dependencies")
        | .archives |= with_entries(
            require(.key | package_type; "\($series): unsupported archive type")
            | .value |= (
                require(type == "object"; "\($series): invalid archive dependencies")
                | reduce ["apt", "apk"][] as $manager (.;
                    require(.[$manager] | type == "array" and all(.[]; safe_name); "\($series): invalid archive package list"))
              )
          )
        | require(.phpVersions | type == "object" and length > 0; "\($series): phpVersions must be a nonempty object")
        | .phpVersions |= with_entries(
            .key as $php
            | require($php | test("^[0-9]+\\.[0-9]+$"); "\($series): invalid PHP version \($php)")
            | .value |= (
                image_config
                | require(.extensions | type == "object"; "missing bundled extension configuration")
                | require(.build.apt | type == "array"; "missing APT build dependencies")
                | require(.build.apk | type == "array"; "missing APK build dependencies")
                | require(.workdir | absolute_path; "invalid workdir")
                | require(.volume | type == "array" and all(.[]; absolute_path); "invalid volume paths")
                | require(.entrypoint | type == "array" and length > 0 and all(.[]; type == "string"); "invalid entrypoint")
                | require(.variants | type == "object"; "missing per-variant image configuration")
                | .variants |= map_values(
                    image_config
                    | require(.base | type == "string" and test("^php:[a-zA-Z0-9_.-]+$"); "invalid PHP base image")
                    | require(.command | type == "array" and length > 0 and all(.[]; type == "string"); "invalid runtime command")
                  )
                | if .dev != null then .dev |= image_config else . end
                | ((.pie // {}) + (.dev.pie // {})) as $pie
                | ((.pecl // {}) + (.dev.pecl // {})) as $pecl
                | require(all($pie | keys[]; . as $name | ($pecl | has($name) | not)); "duplicate installer ownership across dev settings")
                | if ($pie | length) > 0 then
                    require(.download.pie.type == "binary" and .download.pie.temporary == true; "PIE must be a temporary binary download")
                  else . end
              )
          )
        | require(.variants | type == "array" and length > 0; "\($series): variants must be a nonempty array")
        | require(all(.variants[]; IN("apache", "fpm", "fpm-alpine")); "\($series): unsupported runtime variant")
        | require((.variants | unique | length) == (.variants | length); "\($series): duplicate variants")
        | .variants as $variants
        | require(.states | type == "object" and length > 0; "\($series): states must be a nonempty object")
        | .phpVersions as $phpVersions
        | .archives as $archives
        | .states |= with_entries(
            .key as $state
            | require($state | IN("stable", "alpha", "beta", "rc"); "\($series): unsupported release state \($state)")
            | .value |= (
                require(type == "object"; "\($series)/\($state): release must be an object")
                | require(.version | type == "string"; "\($series)/\($state): version must be a string")
                | .version as $version
                | require($version | test("^[0-9]+\\.[0-9]+\\.[0-9]+" + (if $state == "stable" then "" else "-" + $state + "[1-9][0-9]*" end) + "$"); "\($series)/\($state): version does not match release state")
                | require(($version | split(".") | .[0:2] | join(".")) == $series; "\($series)/\($state): version belongs to another series")
                | .aliases = (if .aliases == null then [] else .aliases end)
                | require(.aliases | type == "array"; "\($series)/\($state): aliases must be an array")
                | require(all(.aliases[]; type == "string" or (type == "number" and floor == .)); "\($series)/\($state): aliases must be strings or integer major versions")
                | .aliases |= map(tostring)
                | require(all(.aliases[]; length > 0); "\($series)/\($state): empty alias")
                | require(.php | type == "string"; "\($series)/\($state): php must be a string")
                | require($phpVersions[.php] != null; "\($series)/\($state): default PHP must be in phpVersions")
                | require(.variant | type == "string"; "\($series)/\($state): default variant must be a string")
                | .variant as $defaultVariant
                | require($variants | index($defaultVariant) != null; "\($series)/\($state): default variant must be in variants")
                | require(.packageType | package_type; "\($series)/\($state): unsupported packageType")
                | require($archives[.packageType] != null; "\($series)/\($state): missing dependencies for selected packageType")
                | if .package != null then
                    require(.package | type == "string" and test("^https://[^[:space:]]+$"); "\($series)/\($state): package must be an HTTPS URL")
                  else . end
                | if .sha512 != null then
                    require(.sha512 | sha512; "\($series)/\($state): invalid SHA512")
                    | .sha512 |= ascii_downcase
                  else . end
                | if $mode == "resolved" then
                    require(.package != null and .sha512 != null; "\($series)/\($state): run ./generate.sh to resolve package metadata")
                  else . end
              )
          )
      )
  )
